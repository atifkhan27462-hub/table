# ==============================================================================
# SMART INTERACTIVE DINING TABLE - BACKEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==============================================================================
PROJECT_NAME="Smart Interactive Dining Table API"
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
LOG_FORMAT=console

# Security (Generate a secure 64-char key in production)
SECRET_KEY=replace_with_a_secure_random_key_in_production_32bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_table

# Redis Event Bus & Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Optional AI Service Keys (Phase 10)
GEMINI_API_KEY=
