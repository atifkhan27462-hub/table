# =============================================================================
# Smart Interactive Dining Table Platform — Environment Configuration Template
# Instructions:
# 1. Copy this file to .env (for local Docker) or set in your production secrets manager.
# 2. Never commit actual secret keys or credentials to version control.
# =============================================================================

# --- Project Identity & Runtime Mode ---
PROJECT_NAME="Smart Interactive Dining Table API"
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# --- Security & JWT Authentication ---
# MUST be a cryptographically secure random string of at least 32 characters in production.
# Generate via: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_hex_string_32_chars_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- PostgreSQL Relational Database ---
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=smart_admin
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_DB=smart_table

# --- Redis Cache & Event Bus ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- AI Culinary & Experience Engine ---
# Google Gemini API Key for sommelier recommendations, marketing campaigns, and menu visuals.
GEMINI_API_KEY=

# --- Network & Reverse Proxy CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=https://localhost,https://smarttable.local,https://table.restaurant.com

# --- Hardware & Kiosk Parameters ---
DEFAULT_KIOSK_PIN=7788
HEARTBEAT_TIMEOUT_SECONDS=60
